# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resumora

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# --- Storage (Supabase) ---
# 1. Create a project at https://supabase.com
# 2. Settings -> API -> copy "Project URL" and "service_role" key (NOT the anon key —
#    uploads/downloads/deletes need the service role's elevated permissions)
# 3. Storage -> New bucket -> name it exactly "resumes", set it Private
# Once both vars below are set, the app automatically switches from local disk
# storage to Supabase — no code change needed (see services/storage/base.py)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ---
# 1. Get a free key at https://aistudio.google.com -> "Get API key"
# 2. Set AI_PROVIDER=gemini and paste it below
# Leave AI_PROVIDER=mock (default) to keep running on the offline mock provider —
# no key needed, same interface, see services/ai/mock_provider.py
AI_PROVIDER=mock          # mock | gemini | openai | claude
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- App ---
JWT_SECRET=change-me-in-production
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
